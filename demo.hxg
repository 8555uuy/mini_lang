# HX 语言示例：print(...) 直接输出
fib(n) {
  if (n < 2) { return n; }
  return fib(n - 1) + fib(n - 2);
}
add(a, b) { return a + b; }

print("fib(10) =", fib(10));
print("add(3,4) =", add(3, 4));

n = 42;
print("type(n) =", type(n), "| n =", n);
s = "hi";
print("type(s) =", type(s));
arr2 = [1, 2];
print("type(arr2) =", type(arr2));
print("括号 print 更清晰");

arr = [1, 2, 3];
push(arr, 4);
print("arr =", arr, "len =", len(arr));

d = {name: "hx", ver: 3};
print("dict =", d, "name =", d.name, "ver =", d["ver"]);

i = 0;
sum = 0;
while (i < len(arr)) { sum = sum + arr[i]; i = i + 1; }
print("sum =", sum);

ks = keys(d);
for (i = 0; i < len(ks); i += 1) { print("key:", ks[i]); }
for (j = 0; j < 3; j += 1) { print("j =", j); }
print(upper("abc"), max([3,9,2]));
