{
  "name": "hx-lang",
  "displayName": "HX Language",
  "description": "HX 语言官方扩展：语法高亮、智能补全、小智 Agent、UI 画板",
  "version": "0.1.0",
  "publisher": "hx-lang",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages", "Snippets", "Other"],
  "activationEvents": [
    "onLanguage:hx",
    "onCommand:hx.run",
    "onCommand:hx.openAgent",
    "onCommand:hx.openDesigner",
    "onCommand:hx.setApiKey",
    "onCommand:hx.cheatsheet"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "hx",
        "aliases": ["HX", "hx"],
        "extensions": [".hxg"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "hx",
        "scopeName": "source.hx",
        "path": "./syntaxes/hx.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "hx",
        "path": "./snippets/hx.json"
      }
    ],
    "commands": [
      {
        "command": "hx.run",
        "title": "HX: 运行当前文件",
        "icon": "$(play)"
      },
      {
        "command": "hx.openAgent",
        "title": "HX: 打开小智",
        "icon": "$(sparkle)"
      },
      {
        "command": "hx.openDesigner",
        "title": "HX: 打开 UI 画板",
        "icon": "$(symbol-class)"
      },
      {
        "command": "hx.setApiKey",
        "title": "HX: 配置小智 API"
      },
      {
        "command": "hx.cheatsheet",
        "title": "HX: 语法速查"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hx-sidebar",
          "title": "HX",
          "icon": "media/hx-icon.svg"
        }
      ]
    },
    "views": {
      "hx-sidebar": [
        {
          "id": "hx.apiDocs",
          "name": "API 速查",
          "icon": "media/hx-icon.svg"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "hx.run",
          "when": "resourceExtname == .hxg",
          "group": "navigation"
        },
        {
          "command": "hx.openAgent",
          "when": "resourceExtname == .hxg",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "hx.run",
          "when": "resourceExtname == .hxg",
          "group": "hx@1"
        },
        {
          "command": "hx.openDesigner",
          "when": "resourceExtname == .hxg",
          "group": "hx@2"
        },
        {
          "command": "hx.cheatsheet",
          "group": "hx@3"
        }
      ]
    },
    "configuration": {
      "title": "HX Language",
      "properties": {
        "hx.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "运行 HX 解释器使用的 Python 路径"
        },
        "hx.interpreterPath": {
          "type": "string",
          "default": "",
          "description": "hx.py 的绝对路径，留空则自动在扩展目录和当前工作区查找"
        },
        "hx.ai.baseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com/v1",
          "description": "小智使用的 OpenAI 兼容接口地址"
        },
        "hx.ai.model": {
          "type": "string",
          "default": "deepseek-chat",
          "description": "小智使用的模型名"
        },
        "hx.ai.apiKey": {
          "type": "string",
          "default": "",
          "description": "API Key（建议用命令面板执行 HX: 配置小智 API 保存到 SecretStorage）",
          "markdownDescription": "API Key，建议用命令 **HX: 配置小智 API** 保存到 VS Code SecretStorage"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
