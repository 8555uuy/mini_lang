d = {a:1, b:2};
print(d, keys(d), has(d,"a"), len(d));
d.c = 3;
set(d,"e",5);
print(items(d));
del d.a;
print(d);
ks = keys(d);
for (i = 0; i < len(ks); i += 1) { print("key:", ks[i]); }
nums = [10,20,30];
for (i = 0; i < len(nums); i += 1) { if (nums[i] == 20) { continue; } print("x:", nums[i]); }
i = 0;
while (true) { i += 1; if (i > 3) { break; } }
print("i =", i, "i>3 =", i > 3);
print(upper("abc"), trim("  hi  "), join("-", ["a","b"]), max([3,9,2]));
z = d;
print("type(z) =", type(z));
